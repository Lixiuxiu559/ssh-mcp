# Compose settings. Set UID/GID to the owner of ./runtime.
COMPOSE_PROJECT_NAME=ssh-mcp
DOCKER_UID=1000
DOCKER_GID=1000
SSHMCP_IMAGE=lijx559/ssh-mcp:0.2.0
SSHMCP_BIND_ADDRESS=127.0.0.1
SSHMCP_PORT=8808
TZ=Asia/Shanghai

# Optional resource credentials, referenced by ${VARIABLE} in runtime/config.yaml.
# Web passwords and MCP tokens are managed in the web console.
# EXAMPLE_SSH_PASSWORD=replace-me
# EXAMPLE_KEY_PASSPHRASE=replace-me
