# Optional Compose overrides. The default deployment needs no .env file.
COMPOSE_PROJECT_NAME=ssh-mcp
SSHMCP_IMAGE=lijx559/ssh-mcp:0.3.0
SSHMCP_BIND_ADDRESS=127.0.0.1
SSHMCP_PORT=8808
TZ=Asia/Shanghai

# Resource credentials referenced by ${VARIABLE} in config.yaml must be
# supplied explicitly through docker run -e or Compose environment/env_file.
# Web passwords and MCP tokens are managed in the web console.
# EXAMPLE_SSH_PASSWORD=replace-me
# EXAMPLE_KEY_PASSPHRASE=replace-me
